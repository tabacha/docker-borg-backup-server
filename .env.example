# Vorlage für .env - kopieren, mit echten Werten füllen, NICHT committen:
#   cp .env.example .env
#
# Zusätzlich nötig (siehe README.md):
#   secrets/ssh_host_ed25519_key (+ .pub)  - per setup-secrets.sh erzeugen
#   users/<uid>-<name>/keys/backup/*.pub   - per add-backup-key.sh eintragen
#   users/<uid>-<name>/keys/admin/*.pub    - per add-admin-key.sh eintragen

# Host-Port, auf dem der SSH-Server für Borg-Clients erreichbar ist.
SSH_PORT=2222

# SSH-Krypto-Algorithmen, alle optional - unbelegt kommen die engen
# Defaults aus sshd_config.template zum Einsatz (nur Ed25519, ein einziger
# Cipher). Siehe README "SSH-Härtung". Beispiel, um zusätzlich einen
# RSA-YubiKey (PIV-Applet) als Admin-Key zuzulassen:
# SSHD_PUBKEY_ALGORITHMS=ssh-ed25519,sk-ssh-ed25519@openssh.com,rsa-sha2-512,rsa-sha2-256
# SSHD_KEX_ALGORITHMS=mlkem768x25519-sha256,curve25519-sha256
# SSHD_CIPHERS=chacha20-poly1305@openssh.com
# SSHD_MACS=hmac-sha2-256-etm@openssh.com

# MaxAuthTries, optional (Default 3). sshd zaehlt dabei JEDEN vom Client
# angebotenen Key mit - laeuft bei einem Client ein ssh-agent mit mehreren
# Keys (privater Key + Admin-Key + ...) und wird NICHT mit
# "-o IdentitiesOnly=yes -i <admin-key>" gezielt genau der eine Key
# angegeben, probiert ssh alle Agent-Keys der Reihe nach durch, bevor der
# eigentlich gewuenschte drankommt - bei vielen Keys im Agent laeuft man
# so trotz gueltigem Key in "Too many authentication failures" statt einer
# klaren "Permission denied". Sauberer Fix ist eigentlich clientseitig
# (IdentitiesOnly=yes), dieser Wert ist nur ein Nothelfer, falls das nicht
# in der Hand des Admins liegt.
# SSHD_MAX_AUTH_TRIES=3
