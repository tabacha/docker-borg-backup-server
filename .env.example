# Vorlage für .env - kopieren, mit echten Werten füllen, NICHT committen:
#   cp .env.example .env
#
# Zusätzlich nötig (siehe README.md):
#   secrets/ssh_host_ed25519_key (+ .pub)  - per setup-secrets.sh erzeugen
#   keys/backup/<name>.pub                 - per add-backup-key.sh eintragen
#   keys/admin/<name>.pub                  - per add-admin-key.sh eintragen

# Host-Port, auf dem der SSH-Server für Borg-Clients erreichbar ist.
SSH_PORT=2222
