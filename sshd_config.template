# Minimal-Config fuer einen reinen Borg-Serve-Endpunkt. Kein interaktiver
# Login fuer irgendeinen Key vorgesehen - siehe build-authorized-keys.sh,
# das jeden Key ausnahmslos mit einem Forced Command + "restrict" versieht.
#
# TEMPLATE, kein fertiges sshd_config: die vier __PLATZHALTER__ unten werden
# von entrypoint.sh bei jedem Container-Start durch die Werte aus
# SSHD_PUBKEY_ALGORITHMS/SSHD_KEX_ALGORITHMS/SSHD_CIPHERS/SSHD_MACS ersetzt
# (Defaults dort, falls die Variablen nicht gesetzt sind) und als
# /etc/ssh/sshd_config geschrieben - siehe README "SSH-Haertung" fuer ein
# Beispiel (RSA-YubiKey als zusaetzlichen Admin-Key erlauben).
#
# Kryptografie in den Defaults bewusst eng: dieser Server und der einzige
# erwartete Client (docker-borg-backup) laufen auf demselben
# Debian/OpenSSH-Unterbau (aktuell OpenSSH 10.0p2 auf Debian 13), es muss
# also keine Ruecksicht auf alte/fremde Clients genommen werden. Jede Zeile
# unten mit "sshd -t -f" gegen genau diese OpenSSH-Version getestet (nicht
# nur aus einer Anleitung uebernommen). Quellen:
# infosec.mozilla.org/guidelines/openssh, sshaudit.com/hardening_guides.html

Port 22
HostKey /etc/ssh/ssh_host_ed25519_key

# Nur Ed25519 als HOSTKEY-Algorithmus - fest, nicht per Env konfigurierbar,
# weil dieser Server ausschliesslich Ed25519-Hostkeys erzeugt (siehe
# setup-secrets.sh). Das ist unabhaengig davon, welche Key-Typen fuer
# CLIENTS akzeptiert werden (PubkeyAcceptedAlgorithms unten).
HostKeyAlgorithms ssh-ed25519

# Client-Pubkeys: per SSHD_PUBKEY_ALGORITHMS konfigurierbar. Default nur
# Ed25519 (inkl. sk-ssh-ed25519@openssh.com fuer FIDO2/Hardware-Token-Keys -
# siehe docker-borg-backup README "Sicherheit", YubiKey-Empfehlung fuer den
# Admin-Key). Fuer einen RSA-YubiKey (PIV-Applet statt FIDO2) zusaetzlich
# "rsa-sha2-512,rsa-sha2-256" noetig - siehe README.
PubkeyAcceptedAlgorithms __PUBKEY_ALGORITHMS__

# Kex: per SSHD_KEX_ALGORITHMS konfigurierbar. Default ML-KEM-Hybrid zuerst
# (Post-Quantum, seit OpenSSH 9.9 Standard), Curve25519 als klassischer
# Fallback fuer etwas aeltere Clients (in OpenSSH seit 6.5/2014, also
# praktisch ueberall vorhanden). Keine NIST-P-Kurven, kein klassisches
# Diffie-Hellman in den Defaults.
KexAlgorithms __KEX_ALGORITHMS__

# Cipher: per SSHD_CIPHERS konfigurierbar. Default bewusst NUR
# ChaCha20-Poly1305 - ein AEAD-Cipher (kombinierte
# Verschluesselung+Authentisierung, kein separater MAC-Schritt), kein
# AES-NI/Hardware-Beschleunigung vorausgesetzt, keine bekannten
# praktischen Schwaechen. Einziger Nachteil des Defaults: kein Fallback -
# sollte ChaCha20-Poly1305 je gebrochen werden, muss SSHD_CIPHERS
# aktualisiert werden, bevor sich noch jemand neu verbinden kann. Hier
# bewusst in Kauf genommen (kleinstmoegliche Angriffsflaeche); wer lieber
# eine Fallback-Cipher haette, setzt z.B.
# "chacha20-poly1305@openssh.com,aes256-gcm@openssh.com".
Ciphers __CIPHERS__

# MACs faktisch ungenutzt, solange nur AEAD-Ciphers erlaubt sind (die
# bringen ihre eigene Authentisierung mit) - trotzdem per SSHD_MACS
# konfigurierbar, falls Ciphers mal um eine Nicht-AEAD-Cipher erweitert
# wird.
MACs __MACS__

PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
PubkeyAuthentication yes
AuthorizedKeysFile /home/%u/.ssh/authorized_keys
HostbasedAuthentication no
PermitEmptyPasswords no
PermitUserEnvironment no

# Kein PAM: reine Pubkey-Auth, kein /etc/shadow-Passwort vorgesehen. Mit
# PAM wuerde sshd zusaetzlich den Account-Status pruefen und einen frisch
# angelegten User (der ohne -p ein gesperrtes Passwort hat) ablehnen.
UsePAM no

AllowUsers borg

X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
PermitTunnel no
GatewayPorts no
PrintMotd no
PrintLastLog no
Compression no

# Kein "Subsystem sftp" - wird ohnehin nie erreicht (jeder Key hat ein
# Forced Command, das auch Subsystem-Anfragen ersetzt), explizit weglassen
# statt eine tote Capability in der Config stehen zu lassen.

# Kein fail2ban noetig: OpenSSH bringt seit 9.8 mit PerSourcePenalties
# einen eingebauten Schutz gegen wiederholte Auth-Fehler/Verbindungsabbrueche
# pro Quelle mit (wachsende Sperrzeit), ganz ohne externen Daemon oder
# Firewall-Zugriff aus dem Container heraus. Werte hier = OpenSSH-Default,
# nur explizit hingeschrieben statt sich auf den Default zu verlassen.
PerSourcePenalties crash:90 authfail:5 noauth:1 grace-exceeded:10 refuseconnection:10 max:600 min:15

LogLevel VERBOSE
MaxAuthTries 3
MaxSessions 2
LoginGraceTime 20
VersionAddendum none
DebianBanner no

TCPKeepAlive yes
ClientAliveInterval 60
ClientAliveCountMax 3
